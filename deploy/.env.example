# 复制为 deploy/.env 后按环境修改。整体迁移到别的局域网 Ubuntu 只改这里。
# 数据库（生产 PostgreSQL 16）
RES_DATABASE_URL=postgresql+psycopg://res:res@postgres:5432/res
POSTGRES_USER=res
POSTGRES_PASSWORD=res
POSTGRES_DB=res

# 设备网段（worker 网段发现用，一期预留）
RES_DEVICE_NETWORK=

# 租约 / 凭据 / 巡检
RES_LEASE_TTL_MINUTES=30
RES_LEASE_GRACE_MINUTES=10
RES_HOLDER_CONCURRENCY_LIMIT=2
RES_CREDENTIAL_VALID_DAYS=90
RES_PATROL_INTERVAL_MINUTES=30

# 探测后端：adb=真实(一期 TODO) / http=模拟设备
RES_PROBER_BACKEND=adb

# SMTP（通知一期只落库，此处预留）
RES_SMTP_HOST=
RES_SMTP_PORT=25
RES_SMTP_USER=
RES_SMTP_PASSWORD=
RES_MAIL_FROM=

# 服务域名 / 端口
RES_APP_DOMAIN=res.corp.com
RES_WEB_PORT=8080
RES_MCP_PORT=8765

# 管理员 token（可选；未配则 seed 时 user01 为管理员）
RES_ADMIN_TOKEN=
